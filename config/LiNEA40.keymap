#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse-gesture.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

    // roBa-compatible trackball gestures (window snap / virtual desktop / tab switching),
    // reimplemented via kot149/zmk-mouse-gesture since this board's pmw3610 driver (inorichi
    // fork) has no built-in gesture support like roBa's pmw3610 driver (kumamuk fork). Wired
    // to layers 8/9/10 on &trackball_listener below.
    zip_mouse_gesture_window: zip_mouse_gesture_window {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        always-active;
        suppress-movement;

        right {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(RIGHT_ARROW)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        left {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LEFT_ARROW)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        up {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(UP_ARROW)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        down {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(DOWN_ARROW)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
    };

    zip_mouse_gesture_desktop: zip_mouse_gesture_desktop {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        always-active;
        suppress-movement;

        right {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(LS(F2))>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        left {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LS(F1))>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        up {
            pattern = <GESTURE_UP>;
            bindings = <&kp LC(LS(F3))>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        down {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LC(LS(F4))>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
    };

    zip_mouse_gesture_tab: zip_mouse_gesture_tab {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        always-active;
        suppress-movement;

        right {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(TAB)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        left {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LS(TAB))>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        up {
            pattern = <GESTURE_UP>;
            bindings = <&kp LC(T)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
        down {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LC(W)>;
            wait-ms = <5>;
            tap-ms = <5>;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };

    gesture_window {
        layers = <8>;
        input-processors = <&zip_mouse_gesture_window>;
    };

    gesture_desktop {
        layers = <9>;
        input-processors = <&zip_mouse_gesture_desktop>;
    };

    gesture_tab {
        layers = <10>;
        input-processors = <&zip_mouse_gesture_tab>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <10 11>;
        };

        bluetooth {
            bindings = <&mo 6>;
            key-positions = <35 36>;
        };

        to_L8 {
            bindings = <&mo 8>;
            key-positions = <8 9>;
        };

        to_L9 {
            bindings = <&lt 9 LC(LG(RIGHT_ARROW))>;
            key-positions = <18 19>;
        };

        to_L10 {
            bindings = <&mo 10>;
            key-positions = <28 29>;
        };

        mb_for_drug {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <36 25>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_lang: td_lang {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG";
            #binding-cells = <0>;
            bindings = <&lt 3 LANGUAGE_2>, <&kp LANGUAGE_1>;

            tapping-term-ms = <200>;
        };

        lt_layer: lt_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LAYER";
            #binding-cells = <2>;
            bindings = <&mo>, <&tog>;

            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &lt 5 P
                &lt 2 A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp MINUS
                &mt LEFT_SHIFT Z  &mt LEFT_SHIFT X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &lt 7 SLASH
                &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1  &td_lang  &kp SPACE  &kp BACKSPACE  &lt 4 ENTER  &lt 1 TILDE  &trans  &trans
            >;
                sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //1

        num_arrow {
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &trans  &trans  &trans  &kp SEMICOLON  &kp MINUS  &kp EQUAL  &kp SQT  &trans  &kp UP_ARROW  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //2

        symbol {
            bindings = <
                &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp LCTRL  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
                &trans  &trans  &trans  &kp COLON  &kp UNDERSCORE  &kp PLUS  &kp DOUBLE_QUOTES  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //3

        tenkey_excel {
            bindings = <
                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &kp BACKSPACE  &trans  &trans  &trans  &trans  &trans
                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS  &kp KP_MINUS  &trans  &trans  &trans  &kp LC(HOME)  &trans
                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &kp KP_SLASH  &trans  &trans  &kp LC(PAGE_UP)  &kp LC(END)  &lt 7 LC(PAGE_DOWN)
                &kp KP_COMMA  &kp KP_NUMBER_0  &kp KP_DOT  &kp KP_EQUAL  &tog 3  &kp ENTER  &kp BACKSPACE  &kp ENTER  &trans  &trans  &trans
            >;
        };

        //4

        MOUSE_funktion {
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp F11  &kp F12  &trans  &trans  &trans  &kp F2  &mkp MB1  &mkp MB2  &kp LS(LC(N5))  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(N)  &kp LS(LC(N7))  &kp LS(LC(R))
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //5

        SCROLL {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //6

        bluetooth {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans
            >;
        };

        //7

        MOUSE {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //8

        gesture_window {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //9

        gesture_desktop {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        //10

        gesture_tab {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
